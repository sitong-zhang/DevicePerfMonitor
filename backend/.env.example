# PulseGuard 后端环境变量示例
# 复制为 .env 或直接在部署平台设置；不要提交真实密钥到仓库。

# ---- 服务 ----
PORT=5000
# SQLite 数据库路径（Docker 下挂载 /app/data 卷以持久化）
DB_PATH=/app/data/app.db
# 管理端密码（App 与管理页都使用它）。由管理人员另行分发，
# 部署时填入真实值；未设置时管理端登录一律拒绝。
ADMIN_PASSWORD=
# 应用展示名
APP_NAME=PulseGuard

# ---- SMTP（真实发送邮箱验证码）----
# QQ 邮箱示例：
SMTP_HOST=smtp.qq.com
SMTP_PORT=465
SMTP_USER=your-qq@qq.com
SMTP_PASS=你的SMTP授权码
SMTP_FROM=your-qq@qq.com

# ---- 开发模式 ----
# 1 = SMTP 不通时把验证码回显到 /api/send_code 响应的 dev_code 字段，便于本地联调。
# 生产环境务必设为 0。
DEV_MODE=0

# 验证码有效期（秒）与重发冷却（秒）
CODE_TTL=300
CODE_COOLDOWN=60
