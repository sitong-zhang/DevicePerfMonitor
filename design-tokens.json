{
  "$comment": "双端唯一真源 (single source of truth)。Android 由 app/build.gradle.kts 的 generateDesignTokens 任务生成为 DesignTokens.kt；iOS 由 ios/Tools/generate_tokens.py 生成为 DesignTokens.generated.swift。禁止在业务代码中硬编码色值。",
  "name": "DevicePerfMonitor Design Tokens",
  "version": "1.0.9",
  "palette": {
    "dark": {
      "name": "Material 3 Expressive（种子色 Catppuccin Mauve #CBA6F7）",
      "url": "https://github.com/material-foundation/material-color-utilities",
      "license": "MIT",
      "semantic": {
        "background": "#17101F",
        "surface": "#2C2535",
        "surfaceElevated": "#372F40",
        "textPrimary": "#F0DFFF",
        "textSecondary": "#D4C7DD",
        "accent": "#DEC0FF",
        "accentSecondary": "#9DD1C5",
        "success": "#A6E3A1",
        "warning": "#F9E2AF",
        "danger": "#FD6F85",
        "surfaceLow": "#221A2A",
        "surfaceContainer": "#2C2535",
        "surfaceHigh": "#372F40",
        "surfaceHighest": "#433A4B",
        "surfaceDim": "#0F0817",
        "surfaceBright": "#51485A",
        "tertiary": "#9DD1C5",
        "onTertiary": "#003730",
        "tertiaryContainer": "#1A4F46",
        "onTertiaryContainer": "#BEF3E6",
        "outline": "#9D92A6",
        "outlineVariant": "#5F5668",
        "scrim": "#000000",
        "inverseSurface": "#FFF7FF"
      }
    },
    "light": {
      "name": "Material 3 Expressive（种子色 Catppuccin Mauve #CBA6F7）",
      "url": "https://github.com/catppuccin/catppuccin",
      "license": "MIT",
      "semantic": {
        "background": "#FFF7FF",
        "surface": "#E8E0E8",
        "surfaceElevated": "#DFD8DF",
        "textPrimary": "#3C2A52",
        "textSecondary": "#534F55",
        "accent": "#724DA0",
        "accentSecondary": "#35675D",
        "success": "#40A02B",
        "warning": "#DF8E1D",
        "danger": "#AC3149",
        "surfaceLow": "#F3EBF3",
        "surfaceContainer": "#E8E0E8",
        "surfaceHigh": "#DFD8DF",
        "surfaceHighest": "#D7CFD7",
        "surfaceDim": "#CBC4CC",
        "surfaceBright": "#FFFBFF",
        "tertiary": "#35675D",
        "onTertiary": "#E5FFF7",
        "tertiaryContainer": "#B8EDE0",
        "onTertiaryContainer": "#003730",
        "outline": "#666268",
        "outlineVariant": "#BAB4BB",
        "scrim": "#000000",
        "inverseSurface": "#130A1E"
      }
    }
  },
  "radius": {
    "card": 24,
    "small": 16,
    "large": 28,
    "pill": 999,
    "$comment": "Android dp / iOS pt 等值"
  },
  "spacing": [4, 8, 12, 16, 24, 32],
  "blur": {
    "glass": 32,
    "subtle": 24,
    "overlayMin": 28,
    "overlayMax": 36,
    "$comment": "Android dp / iOS pt 等值；overlay 指悬浮窗场景。1.0.8 起仅 iOS 侧使用（LiquidGlassKit）；Android 端已换 Material 3 Expressive 视觉，无自绘模糊。"
  },
  "glass": {
    "backgroundAlpha": { "min": 0.18, "max": 0.28 },
    "borderWidth": 1,
    "borderAlpha": 0.35,
    "highlightAlphaTop": 0.55,
    "highlightAlphaBottom": 0.12,
    "innerShadowAlpha": 0.10,
    "outerShadowAlpha": 0.22,
    "outerShadowRadius": 20,
    "outerShadowOffsetY": 8,
    "saturationBoost": 1.12,
    "noiseAlpha": 0.035,
    "$comment": "iOS 液态玻璃材质参数（LiquidGlassKit 驱动）：背景透明度 18%~28% 随告警态自适应，柔和弥散外阴影。1.0.8 起仅 iOS 侧使用——Android 端已换用 Material 3 Expressive 视觉（theme/Theme.kt），不再自绘玻璃。"
  },
  "surface": {
    "cardPadding": 16,
    "gap": 14,
    "borderWidth": 1,
    "borderAlpha": 0.22,
    "highlightAlpha": 0.05,
    "$comment": "卡片/面板的视觉层次（1.0.9）。以前控件零描边零高光、内边距各页各写一份（Settings 还叠成了 32），现在统一由这里给出：卡片内边距、卡片间距、描边宽度与浓度、顶部高光浓度。"
  },
  "elevation": {
    "level1": {
      "shadowY": 2,
      "radius": 8,
      "alpha": 0.3
    },
    "level2": {
      "shadowY": 6,
      "radius": 18,
      "alpha": 0.36
    },
    "level3": {
      "shadowY": 12,
      "radius": 32,
      "alpha": 0.44
    },
    "$comment": "三层投影：1=卡片，2=浮动底栏，3=弹层/拖拽中的悬浮窗。以前一律零阴影，界面因此完全没有层次。"
  },
  "bottomBar": {
    "height": 62,
    "marginHorizontal": 24,
    "marginBottom": 24,
    "indicatorInset": 4,
    "iconSize": 24,
    "labelSize": 11,
    "indicatorAlpha": 0.18,
    "selectedScale": 1.08,
    "$comment": "浮动胶囊底栏几何（双端一致）：悬浮在内容之上、左右下留边距，圆角用 radius.pill。选中态是滑动的 pill 指示器，动效走 motion.spring.fastSpatial。"
  },
  "motion": {
    "enter": {
      "durationMs": 320,
      "cubicBezier": [0.05, 0.7, 0.1, 1.0]
    },
    "exit": {
      "durationMs": 240,
      "cubicBezier": [0.3, 0.0, 0.8, 0.15]
    },
    "emphasized": {
      "durationMs": 300,
      "cubicBezier": [0.2, 0.0, 0.0, 1.0]
    },
    "spring": {
      "fastSpatial": { "dampingRatio": 0.6, "stiffness": 800 },
      "defaultSpatial": { "dampingRatio": 0.8, "stiffness": 380 },
      "slowSpatial": { "dampingRatio": 0.8, "stiffness": 200 },
      "$comment": "Material 3 Expressive 空间弹簧（与 androidx ExpressiveMotionTokens 同参数）：fastSpatial=按压/形态切换等改边界的短促动效，defaultSpatial=中等形变，slowSpatial=大范围位移。Compose 侧 dampingRatio/stiffness 直接使用；SwiftUI 侧由生成器换算 response=2π/√stiffness、dampingFraction=dampingRatio/2。"
    },
    "$comment": "三条曲线替代原单一 300ms；所有页面切换/卡片展开/数值变化/悬浮窗弹出收起必须使用其中之一。组件级交互（按压、形态切换）走 spring（Material 3 Expressive 物理曲线）。"
  },
  "number": {
    "$comment": "数值缓动：时长 = min(300ms, 刷新间隔 - 50ms)；新数据到达时从当前显示值继续缓动，不重播动画",
    "maxDurationMs": 300,
    "intervalMarginMs": 50
  },
  "typography": {
    "sans": {
      "family": "Inter",
      "url": "https://github.com/rsms/inter",
      "license": "OFL-1.1",
      "licenseUrl": "https://github.com/rsms/inter/blob/master/LICENSE.txt"
    },
    "mono": {
      "family": "JetBrains Mono",
      "url": "https://github.com/JetBrains/JetBrainsMono",
      "license": "OFL-1.1",
      "licenseUrl": "https://github.com/JetBrains/JetBrainsMono/blob/master/OFL.txt"
    },
    "$comment": "数字一律使用等宽字体，保证数值跳动时不晃动；字体文件随工程打包"
  },
  "gesture": {
    "doubleTapWindowMs": 250,
    "touchSlopDp": 8,
    "edgeSnapThresholdDp": 96,
    "trashZoneHeightDp": 140,
    "scaleRange": [0.8, 1.6]
  },
  "health": {
    "$comment": "综合评分权重与公式，与 analysis 模块保持一致；任一维度不可用时权重按比例分配给其余可用维度",
    "weights": { "temperature": 0.4, "frameStability": 0.3, "battery": 0.2, "memory": 0.1 },
    "temperatureBreakpoints": [
      { "max": 40, "score": 100 },
      { "max": 50, "from": 100, "to": 70 },
      { "max": 60, "from": 70, "to": 35 },
      { "max": 70, "from": 35, "to": 10 },
      { "max": null, "score": 0 }
    ],
    "grades": [
      { "min": 90, "label": "优秀" },
      { "min": 70, "label": "良好" },
      { "min": 50, "label": "一般" },
      { "min": 0, "label": "警告" }
    ]
  }
}
