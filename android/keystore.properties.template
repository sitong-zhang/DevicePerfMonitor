# keystore.properties 模板
# 使用方法：
#   1. 复制本文件为 keystore.properties（已被 .gitignore 忽略，不会提交密码）
#   2. 用下方 keytool 命令生成签名密钥（密码请替换为你自己的强密码）
#   3. storeFile 支持相对路径（相对 android/ 目录）或绝对路径
#
# 生成密钥示例（JDK 17）：
#   keytool -genkeypair -v \
#     -keystore devperf-release.keystore \
#     -alias devperf \
#     -keyalg RSA -keysize 4096 -validity 10000 \
#     -storepass YOUR_STORE_PASSWORD -keypass YOUR_KEY_PASSWORD \
#     -dname "CN=DevicePerfMonitor, O=YourOrg, C=CN"
#
# 之后执行 ./build-apk.sh 即可产出 signed release APK。
# 未提供 keystore.properties 时，构建脚本自动降级为 debug 签名并在 README 说明。
#
# !! 私钥安全 !!
#   - keystore + 密码丢 = 无法补签，只能换签名，用户必须卸载重装（数据清空）。
#     生成后立刻备份（密码管理器 + 离线副本各一份）。
#   - 本仓库正式 keystore（alias=devperf，CN=DevicePerfMonitor）自 1.0.26 起使用，
#     同一份已存入 GitHub secrets 供 CI 签名；换新 keystore 前必须同步更新 secrets，
#     否则 CI 产物与本地签名不一致。
#   - 证书有效期 10000 天（约 2054 年），到期前需重新规划，Play 上架另算。

storeFile=devperf-release.keystore
storePassword=YOUR_STORE_PASSWORD
keyAlias=devperf
keyPassword=YOUR_KEY_PASSWORD
