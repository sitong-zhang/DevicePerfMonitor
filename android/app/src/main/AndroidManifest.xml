<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- ============ 权限说明 ============ -->
    <!-- 悬浮窗：核心功能，全局悬浮窗必须 -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <!-- 前台服务：采集引擎与悬浮窗保活（Android 14+ 强制声明类型） -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <!-- 通知：高温告警 / 前台常驻通知 -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- 重启后按用户设置恢复悬浮窗 -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- 可选权限：仅当用户主动开启「全局 FPS / 后台应用内存」时引导授权，
         用于获取前台应用包名；不申请则相关指标显示"不可用" -->
    <uses-permission
        android:name="android.permission.PACKAGE_USAGE_STATS"
        tools:ignore="ProtectedPermissions" />
    <!-- Shizuku：可选的免 root 提权通道（全局 FPS / 后台内存 / 各核心频率） -->
    <uses-permission android:name="moe.shizuku.manager.permission.API_V23" />

    <!-- 应用内版本检查与更新（1.0.15 新增）：唯一的联网路径，仅读取公开的
         GitHub Releases 元数据，不向任何服务器上报任何数据 -->
    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:name=".MonitorApp"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.DevicePerfMonitor"
        tools:targetApi="34">

        <!-- 崩溃展示页：独立进程，纯 View 实现，避免与主进程相同渲染崩溃 -->
        <activity
            android:name=".CrashActivity"
            android:exported="false"
            android:process=":crash"
            android:theme="@style/Theme.Crash" />

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|uiMode|density"
            android:theme="@style/Theme.DevicePerfMonitor">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- 采集引擎：独立前台服务，主 App 退出后仍可按设置继续采集（历史/悬浮窗需要） -->
        <service
            android:name=".data.CollectionService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="device_performance_monitoring" />
        </service>

        <!-- 全局悬浮窗 -->
        <service
            android:name=".overlay.OverlayService"
            android:exported="false"
            android:foregroundServiceType="specialUse"
            android:stopWithTask="false">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="device_performance_monitoring" />
        </service>

        <receiver
            android:name=".overlay.BootCompletedReceiver"
            android:enabled="true"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <!-- Shizuku 客户端必须声明的 Provider（接收 Shizuku Binder / 权限回调） -->
        <provider
            android:name="rikka.shizuku.ShizukuProvider"
            android:authorities="${applicationId}.shizuku"
            android:exported="true"
            android:multiprocess="false" />

        <!-- 应用内更新安装：用 FileProvider 暴露下载到缓存的 APK，拉起系统安装器 -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>

    <!-- Android 11+ 包可见性：检测 Shizuku App 是否安装 -->
    <queries>
        <package android:name="moe.shizuku.privileged.api" />
    </queries>
</manifest>
