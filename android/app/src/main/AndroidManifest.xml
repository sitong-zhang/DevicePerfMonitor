<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- ============ 权限说明 ============ -->
    <!-- 悬浮窗：核心功能，全局悬浮窗必须 -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <!-- 前台服务：采集引擎与悬浮窗保活（Android 14+ 强制声明类型） -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <!-- 通知：高温告警 / 前台常驻通知 -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- 深度监测：电池电压 / 电流 / 电量与充放电状态（普通权限，声明即生效） -->
    <uses-permission android:name="android.permission.BATTERY_STATS" />
    <!-- 深度监测：网络细分（WiFi 状态 / 蜂窝网络类型，普通权限） -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <!-- 重启后按用户设置恢复悬浮窗 -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- 可选权限：仅当用户主动开启「全局 FPS / 后台应用内存」时引导授权，
         用于获取前台应用包名；不申请则相关指标显示"不可用" -->
    <uses-permission
        android:name="android.permission.PACKAGE_USAGE_STATS"
        tools:ignore="ProtectedPermissions" />
    <!-- 深度监测：蜂窝细分（网络类型 / 运营商 / 信号强度 RSRP·RSRQ）。
         危险权限，App 启动时与其他运行时权限一并申请；未授予时相关指标
         自动降级为"推算 + 说明"，不影响其余功能 -->
    <uses-permission android:name="android.permission.READ_PHONE_STATE" />
    <!-- Android 13+ 的普通权限：无需弹窗即可读取基本电话状态（网络类型等），
         作为 READ_PHONE_STATE 被拒时的兜底通道 -->
    <uses-permission android:name="android.permission.READ_BASIC_PHONE_STATE" />
    <!-- 深度监测：WiFi SSID / 信道环境 + 蜂窝信号强度（Android 11+ 读取
         SignalStrength 需要位置类权限）。仅用于网络质量指标，不采集、
         不上报任何位置信息 -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <!-- Android 13+：读取 WiFi SSID 的正式通道，声明 neverForLocation 明确
         不用于定位（targetSdk 33+ 起 SSID 需此权限或精确定位权限） -->
    <uses-permission
        android:name="android.permission.NEARBY_WIFI_DEVICES"
        android:usesPermissionFlags="neverForLocation"
        tools:targetApi="33" />
    <!-- 深度监测：进程/应用名映射更完整（把 uid 解析成可读应用名） -->
    <uses-permission
        android:name="android.permission.QUERY_ALL_PACKAGES"
        tools:ignore="QueryAllPackagesPermission" />
    <!-- Shizuku：可选的免 root 提权通道（全局 FPS / 后台内存 / 各核心频率） -->
    <uses-permission android:name="moe.shizuku.manager.permission.API_V23" />

    <!-- 应用内版本检查与更新（1.0.15 新增）：唯一的联网路径，仅读取公开的
         GitHub Releases 元数据，不向任何服务器上报任何数据 -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- 应用内更新下载 APK 后拉起系统安装器（1.0.18）：Android 8+ 需要，
         且用户须在系统设置里给本应用授予「安装未知应用」；
         只用于安装从官方 GitHub Releases 下载的更新包 -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <application
        android:name=".MonitorApp"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.DevicePerfMonitor"
        tools:targetApi="34">

        <!-- 崩溃展示页：独立进程，纯 View 实现，避免与主进程相同渲染崩溃 -->
        <activity
            android:name=".CrashActivity"
            android:exported="false"
            android:process=":crash"
            android:theme="@style/Theme.Crash" />

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|uiMode|density"
            android:theme="@style/Theme.DevicePerfMonitor">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- 采集引擎：独立前台服务，主 App 退出后仍可按设置继续采集（历史/悬浮窗需要） -->
        <service
            android:name=".data.CollectionService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="device_performance_monitoring" />
        </service>

        <!-- 全局悬浮窗 -->
        <service
            android:name=".overlay.OverlayService"
            android:exported="false"
            android:foregroundServiceType="specialUse"
            android:stopWithTask="false">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="device_performance_monitoring" />
        </service>

        <receiver
            android:name=".overlay.BootCompletedReceiver"
            android:enabled="true"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <!-- Shizuku 客户端必须声明的 Provider（接收 Shizuku Binder / 权限回调） -->
        <provider
            android:name="rikka.shizuku.ShizukuProvider"
            android:authorities="${applicationId}.shizuku"
            android:exported="true"
            android:multiprocess="false" />

        <!-- 应用内更新安装：用 FileProvider 暴露下载到缓存的 APK，拉起系统安装器 -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>

    <!-- Android 11+ 包可见性：检测 Shizuku App 是否安装 -->
    <queries>
        <package android:name="moe.shizuku.privileged.api" />
    </queries>
</manifest>
