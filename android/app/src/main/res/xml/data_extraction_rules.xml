<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+ 备份规则：仅备份设置（datastore）；历史性能数据不参与备份/迁移。
     注意：未列入 include 的路径默认即不备份，无需再写 exclude
     （lint FullBackupContent 会校验 exclude 必须位于 include 路径之内）。 -->
<data-extraction-rules>
    <cloud-backup>
        <include domain="file" path="datastore" />
    </cloud-backup>
    <device-transfer>
        <include domain="file" path="datastore" />
    </device-transfer>
</data-extraction-rules>
